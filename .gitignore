# 别把投稿数据和照片推上 GitHub（体积大，且含同学个人信息）
data/photos/
data/thumbs/
data/exports/
data/submissions.jsonl
data/admin.json
data/.submit.lock
data/tile_check/

# 投票数据（2026-10-06 新增）：本地后端的票箱。**里面存着投票人姓名明文**
# 与学号/手机号的加盐哈希 —— 既是个人数据，也绝不能进仓库。
# （云端投票走 Supabase 的 voters/votes 表，本来就不落文件。）
data/votes.json
data/votes.json.tmp

# 云端密钥绝不入库
.streamlit/secrets.toml
deploy/secrets.toml
.env

# 本机运维文件（🔴 含口令，绝不能提交）：data/ 不是整目录忽略，
# 只忽略下面这些具体项，所以**新增任何含密钥/口令的文件都要在这里补一行**。
data/*口令*
data/*密码*
data/*secret*
data/*credential*

# 瓦片缓存（可再生，体积大，别提交）
data/tile_cache/

# ⚠️ 但 data/frame_images/ **要提交**：那是预生成的"外框静态底图"，
# 总共才 ~1 MB，提交后云端容器重启也无需现场拉瓦片（否则首次访问会慢且可能被限流）。
# 同时把 data/tile_check/ 的既有忽略规则保留，那里是人工校对用的中间图。

# 打包产物
dist/
*.zip

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# 注意：data/raw/ 要保留并提交 —— 那是三校区底图，地图没它就没有建筑轮廓。

# 苏州配准校准用的临时底图缓存（体积大、可再生）
data/tile_check/suzhou_base_*.jpg

# 截图/校验产生的临时图片（别误提交）
_live.png
_live_verify.png
_frame_shot.png
_submit_shot.png
_iso_shot.png
_page_*.png

# 临时提交信息文件（别入库）
_cm.txt
_commit_msg.txt
# 测试会临时生成小尺寸底图（w600/w700），属可再生中间产物，别入库
data/frame_images/*_w600_*
data/frame_images/*_w700_*
